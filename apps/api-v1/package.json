{
  "name": "@phoenix/api-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon --watch \"**/*.js\" --exec \"node ./bin/www\"",
    "build": "esbuild ./bin/www --bundle --platform=node --outfile=./dist/server.js"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.14"
  }
}
