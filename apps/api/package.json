{
  "name": "@phoenix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run clean && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "NODE_ENV=preview bun run build && node ./dist/index.js",
    "start:prod": "NODE_ENV=production bun run build && node ./dist/index.js",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@phoenix/jest-presets/node"
  },
  "dependencies": {
    "@phoenix/logger": "*",
    "@phoenix/tmdb": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@jest/globals": "^30.2.0",
    "@phoenix/eslint-config": "*",
    "@phoenix/jest-presets": "*",
    "@phoenix/typescript-config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.20.1",
    "esbuild-register": "^3.5.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.3",
    "typescript": "5.5.4"
  }
}
